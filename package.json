{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "start": "pnpm --filter scratch-gui run start",
    "server": "pnpm --filter scratch-vm run server",
    "format": "prettier . --write && pnpm -r run format",
    "check-format": "prettier . --check && pnpm -r run check-format"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.4",
    "prettier": "^3.10.1"
  }
}
